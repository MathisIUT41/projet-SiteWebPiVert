{% extends 'base.twig' %}
{% import 'partials/icones.twig' as i %}

{% block titre %}Valider ma commande · PiVert{% endblock %}

{% block contenu %}
<section class="page-entete">
    <h1 class="page-titre">Valider ma commande</h1>
    <p class="page-intro">Vérifie tes articles et ton adresse, puis confirme.</p>
</section>

<div class="panier">
    <div class="commande-colonne">
        <section class="commande-bloc" aria-labelledby="articles-titre">
            <h2 class="commande-bloc-titre" id="articles-titre">Tes articles</h2>
            <ul class="commande-lignes">
                {% for l in lignes %}
                    <li class="commande-ligne theme-{{ l.univers }}">
                        <img src="{{ image_produit(l.photo_nom) }}" alt="" width="56" height="56">
                        <span class="commande-ligne-nom">{{ l.nom }}</span>
                        <span class="commande-ligne-qte">× {{ l.quantite }}</span>
                        <strong>{{ l.sous_total|prix }}</strong>
                    </li>
                {% endfor %}
            </ul>
            {% if ruptures is not empty %}
                <p class="message-erreur">
                    {{ i.icone('alerte') }}
                    Plus en stock, non commandé{{ ruptures|length > 1 ? 's' }} : {{ ruptures|map(r => r.nom)|join(', ') }}.
                </p>
            {% endif %}
        </section>

        <section class="commande-bloc" aria-labelledby="livraison-titre">
            <h2 class="commande-bloc-titre" id="livraison-titre">Livraison</h2>
            <p class="commande-adresse">
                <strong>{{ client.prenom }} {{ client.nom }}</strong><br>
                {{ client.adresse }}
            </p>
        </section>
    </div>

    <aside class="panier-recap" aria-labelledby="recap-titre">
        <h2 id="recap-titre" class="panier-recap-titre">Total</h2>
        <dl class="panier-recap-lignes">
            <div><dt>Articles</dt><dd>{{ lignes|reduce((somme, l) => somme + l.quantite, 0) }}</dd></div>
            <div class="panier-recap-total"><dt>À régler</dt><dd>{{ total|prix }}</dd></div>
        </dl>
        <form method="post" action="commande.php">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <button class="bouton bouton--sombre bouton--large" type="submit">Confirmer la commande</button>
        </form>
        <a class="bouton bouton--contour bouton--large" href="panier.php">Modifier mon panier</a>
        <p class="champ-aide">Site de démonstration : aucun paiement n'est demandé.</p>
    </aside>
</div>
{% endblock %}
