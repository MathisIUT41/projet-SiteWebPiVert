<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titre %}PiVert faunes &amp; flores{% endblock %}</title>
    <meta name="description" content="{% block description %}Plantes, fleurs, arbres, animaux et tout ce qu'il faut pour en prendre soin.{% endblock %}">
    <link rel="icon" href="{{ base_url }}assets/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,800&amp;display=swap">
    <link rel="stylesheet" href="{{ base_url }}assets/css/tokens.css">
    <link rel="stylesheet" href="{{ base_url }}assets/css/base.css">
    <link rel="stylesheet" href="{{ base_url }}assets/css/composants.css">
    <link rel="stylesheet" href="{{ base_url }}assets/css/pages.css">
    {% block styles %}{% endblock %}
</head>
<body{% if univers %} data-univers="{{ univers }}"{% endif %}>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>

    {% block entete %}{% include 'partials/nav.twig' %}{% endblock %}

    <main id="contenu" class="{% block classe_main %}page{% endblock %}">
        {% block contenu %}{% endblock %}
    </main>

    {% include 'partials/toasts.twig' %}

    {% block pied %}{% include 'partials/footer.twig' %}{% endblock %}

    <script type="module" src="{{ base_url }}assets/js/nav.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
